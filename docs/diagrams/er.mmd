  USER {
    bigint id PK
    string username UK
    string first_name
    string last_name
    string email
    bool is_active
    datetime date_joined "UTC"
  }
  GROUP {
    int id PK
    string name UK "Talep Sahibi | Destek Personeli | Yönetici"
  }
  PERMISSION {
    int id PK
    string codename "access_support_workspace vb."
  }
  TICKET {
    bigint id PK
    string number UK "INC-000123 (Hafta 3)"
    string title
    text description
    string status "OPEN | IN_PROGRESS | RESOLVED | CLOSED"
    string priority "P1..P4"
    datetime created_at "UTC"
    datetime first_response_at "UTC"
    datetime resolved_at "UTC"
    datetime closed_at "UTC"
    bool escalated
  }
  SLA_EVENT {
    bigint id PK
    string metric "FIRST_RESPONSE | RESOLUTION"
    string kind "WARNING | BREACH"
    datetime occurred_at "UTC"
    string unique_key UK "talep + ölçüt + tür"
  }
  SURVEY {
    bigint id PK
    bigint ticket_id UK
    int score "1..5"
  }
  AUDIT_LOG {
    bigint id PK
    string action
    string old_value
    string new_value
    datetime at "UTC, yalnız ekleme"
  }
